[Unit]
Description=Sonos Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sonosweb
Group=sonosweb

WorkingDirectory=/opt/sonos-web/sonos-web
Environment="PATH=/opt/sonos-web/sonos-web/venv/bin"

ExecStart=/opt/sonos-web/sonos-web/venv/bin/gunicorn \
    --chdir /opt/sonos-web/sonos-web \
    --bind 127.0.0.1:5000 \
    --workers 1 \
    --threads 4 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    app:app

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
